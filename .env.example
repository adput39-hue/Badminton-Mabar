# ============================================
# DEVELOPMENT (localhost)
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/badminton_mabar"

# ============================================
# PRODUCTION (Supabase - Transaction pooler)
# Copy paste ke Vercel dashboard > Settings > Environment Variables
# ============================================
# DATABASE_URL="postgresql://postgres.kexfzzjnwzndppetnlba:Kendangsari11@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Optional: Supabase API (tidak dipakai saat ini)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================
# FIREBASE (Firestore untuk live score + WhatsApp bot hub)
# Buat project di https://console.firebase.google.com
# Aktifkan Firestore > Create database > Start in test mode
# Dapet config dari: Project Settings > General > Your apps > Web app
# ============================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================
# FIREBASE ADMIN (dipakai server Vercel + bot PC)
# 1. Console > Project Settings > Service accounts > Generate new private key
# 2. Paste isi file JSON (1 baris) ke sini, ATAU simpan sebagai firebase-service-account.json di root
#    (file tsb di .gitignore, jangan pernah dicommit)
# 3. Jangan lupa deploy firestore.rules (scripts/deploy-firestore-rules.js)
# ============================================
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=

# Optional: App config
NEXT_PUBLIC_APP_NAME=Badminton Mabar
