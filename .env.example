# ============================================
# DEVELOPMENT (localhost)
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/badminton_mabar"

# ============================================
# PRODUCTION (Supabase - Transaction pooler)
# Copy paste ke Vercel dashboard > Settings > Environment Variables
# ============================================
# DATABASE_URL="postgresql://postgres.kexfzzjnwzndppetnlba:Kendangsari11@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Optional: Supabase API (tidak dipakai saat ini)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================
# FIREBASE (Realtime Database untuk live score)
# Buat project di https://console.firebase.google.com
# Aktifkan Realtime Database > Create Database > Start in test mode
# Dapet config dari: Project Settings > General > Your apps > Web app
# ============================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: App config
NEXT_PUBLIC_APP_NAME=Badminton Mabar
